<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mental.mapper.MoodDiaryMapper">

    <resultMap id="BaseResultMap" type="com.mental.entity.MoodDiary">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="moodScore" column="mood_score"/>
        <result property="moodEmoji" column="mood_emoji"/>
        <result property="content" column="content"/>
        <result property="tags" column="tags"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="DetailResultMap" type="com.mental.entity.MoodDiary" extends="BaseResultMap">
        <result property="userName" column="user_name"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM mood_diary WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM mood_diary WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="findAll" resultMap="DetailResultMap">
        SELECT md.*, u.real_name AS user_name
        FROM mood_diary md
        LEFT JOIN users u ON md.user_id = u.id
        ORDER BY md.create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO mood_diary (user_id, mood_score, mood_emoji, content, tags)
        VALUES (#{userId}, #{moodScore}, #{moodEmoji}, #{content}, #{tags})
    </insert>

    <delete id="deleteById">
        DELETE FROM mood_diary WHERE id = #{id}
    </delete>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM mood_diary WHERE user_id = #{userId}
    </select>
</mapper>
