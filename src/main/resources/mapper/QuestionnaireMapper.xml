<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mental.mapper.QuestionnaireMapper">

    <resultMap id="BaseResultMap" type="com.mental.entity.Questionnaire">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="totalScore" column="total_score"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findById" resultMap="BaseResultMap">
        SELECT * FROM questionnaire WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM questionnaire ORDER BY create_time DESC
    </select>

    <select id="findActive" resultMap="BaseResultMap">
        SELECT * FROM questionnaire WHERE status = 1 ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO questionnaire (title, description, total_score, status)
        VALUES (#{title}, #{description}, #{totalScore}, #{status})
    </insert>

    <update id="update">
        UPDATE questionnaire
        SET title = #{title}, description = #{description}, total_score = #{totalScore}, status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM questionnaire WHERE id = #{id}
    </delete>
</mapper>
